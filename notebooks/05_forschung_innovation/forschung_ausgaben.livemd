## Fragestellung

> Wer forscht, wer zahlt — und was bekommt die Schweiz pro F&E-Franken zurück?

**Kategorie**: Datenbriefing
**Evidenzstärke**: stark (BFS-Forschungsstatistik + OECD/EPO-Daten)
**Ergebnis**: Leichte Einordnung (öffentlich/privat-Spannung ist echt)

## Daten laden

```elixir
alias Explorer.DataFrame, as: DF
alias Explorer.Series
alias VegaLite, as: Vl

df_rd = Zukunftslabor.DataLoader.load("forschung_ausgaben")

# Überblick
latest_year = df_rd |> DF.pull("Jahr") |> Series.max()
years = df_rd |> DF.pull("Jahr") |> Series.distinct() |> Series.sort() |> Series.to_list()
IO.puts("Verfügbare Jahre: #{inspect(years)}")
IO.puts("Neuestes Jahr: #{latest_year}")
```

## F&E-Ausgaben nach Sektor im Zeitverlauf (Stacked Area)

```elixir
# Hauptsektoren identifizieren (Top-Sektoren im neuesten Jahr, ohne "Total"-Zeilen)
df_latest =
  df_rd
  |> DF.filter(col("Jahr") == ^latest_year)
  |> DF.filter(not contains(col("Sektor"), "Total"))
  |> DF.sort_by(desc: col("Ausgaben_Mio_CHF"))

top_sectors =
  df_latest
  |> DF.head(6)
  |> DF.pull("Sektor")
  |> Series.to_list()

# Zeitreihe für Top-Sektoren
sector_data =
  df_rd
  |> DF.to_rows()
  |> Enum.filter(fn row -> row["Sektor"] in top_sectors end)

chart_sektoren =
  Vl.new(
    width: 720,
    height: 420,
    title: "F&E-Ausgaben nach Sektor — Schweiz (#{hd(years)}–#{latest_year})"
  )
  |> Vl.data_from_values(sector_data)
  |> Vl.mark(:area, opacity: 0.8)
  |> Vl.encode_field(:x, "Jahr", type: :ordinal, title: "Jahr")
  |> Vl.encode_field(:y, "Ausgaben_Mio_CHF",
    type: :quantitative,
    title: "Mio. CHF",
    stack: :zero
  )
  |> Vl.encode_field(:color, "Sektor",
    type: :nominal,
    scale: [range: ["#a855f7", "#3b82f6", "#06b6d4", "#10b981", "#f59e0b", "#ef4444"]]
  )
  |> Vl.config(
    font: "Switzer, system-ui, sans-serif",
    view: [stroke: "transparent"]
  )
```

## Privatwirtschaft vs. Öffentliche Hand

```elixir
# Privat = "Total" der Privatwirtschaft (erster "Total"-Eintrag, höchster Wert)
# Öffentlich = Hochschulen + ETH-Forschungsanstalten + Bund
# Die CSV hat mehrere "Total"-Zeilen: Total Suisse, Total (Privatwirtschaft),
# Total (Hochschulen), Total (Bund)

# Klassifikation: Sektoren der Privatwirtschaft
private_keywords = ["Chimie", "Métallurgie", "Instruments", "Technologie", "Alimentation",
                    "Autres non répartis", "Recherche et développement"]
public_keywords = ["Hautes écoles", "Etablissements de recherche", "Département"]

ratio_data =
  Enum.map(years, fn year ->
    year_rows =
      df_rd
      |> DF.filter(col("Jahr") == ^year)
      |> DF.filter(not contains(col("Sektor"), "Total"))
      |> DF.to_rows()

    private =
      year_rows
      |> Enum.filter(fn r ->
        Enum.any?(private_keywords, &String.contains?(r["Sektor"], &1))
      end)
      |> Enum.map(& &1["Ausgaben_Mio_CHF"])
      |> Enum.sum()

    public =
      year_rows
      |> Enum.filter(fn r ->
        Enum.any?(public_keywords, &String.contains?(r["Sektor"], &1))
      end)
      |> Enum.map(& &1["Ausgaben_Mio_CHF"])
      |> Enum.sum()

    ratio = if public > 0, do: Float.round(private / public, 2), else: 0.0

    %{"Jahr" => year, "Verhältnis" => ratio, "Privat" => round(private), "Öffentlich" => round(public)}
  end)

chart_ratio =
  Vl.new(
    width: 720,
    height: 350,
    title: "Verhältnis Privatwirtschaft / Öffentliche Hand bei F&E-Ausgaben"
  )
  |> Vl.data_from_values(ratio_data)
  |> Vl.mark(:line, point: [size: 80], stroke_width: 2.5)
  |> Vl.encode_field(:x, "Jahr", type: :ordinal, title: "Jahr")
  |> Vl.encode_field(:y, "Verhältnis",
    type: :quantitative,
    title: "Privat ÷ Öffentlich",
    scale: [domain: [0, 4]]
  )
  |> Vl.encode(:color, value: "#a855f7")
  |> Vl.config(
    font: "Switzer, system-ui, sans-serif",
    view: [stroke: "transparent"]
  )
```

## Patente pro F&E-Milliarde (Effizienz-Vergleich)

```elixir
# EPO-Patentanmeldungen pro Milliarde F&E-Ausgaben — Schweiz vs. OECD-Peers
# Quellen: EPO Annual Report 2023, OECD GERD
# Patente: EPO-Anmeldungen 2023, F&E: GERD in Mrd. USD KKP 2022
patent_data = [
  %{"Land" => "Schweiz", "Patente/Mrd" => 182, "F&E_Mrd_USD" => 24.1},
  %{"Land" => "Schweden", "Patente/Mrd" => 115, "F&E_Mrd_USD" => 21.8},
  %{"Land" => "Niederlande", "Patente/Mrd" => 109, "F&E_Mrd_USD" => 24.3},
  %{"Land" => "Deutschland", "Patente/Mrd" => 87, "F&E_Mrd_USD" => 142.0},
  %{"Land" => "Österreich", "Patente/Mrd" => 79, "F&E_Mrd_USD" => 17.4},
  %{"Land" => "Frankreich", "Patente/Mrd" => 59, "F&E_Mrd_USD" => 72.8},
  %{"Land" => "USA", "Patente/Mrd" => 37, "F&E_Mrd_USD" => 806.0},
  %{"Land" => "Japan", "Patente/Mrd" => 25, "F&E_Mrd_USD" => 174.0}
]

chart_patente =
  Vl.new(
    width: 720,
    height: 380,
    title: "Patenteffizienz: EPO-Patentanmeldungen pro Milliarde F&E-Ausgaben (2023)"
  )
  |> Vl.data_from_values(patent_data)
  |> Vl.mark(:bar, corner_radius_end: 4)
  |> Vl.encode_field(:y, "Land", type: :nominal, title: nil, sort: "-x")
  |> Vl.encode_field(:x, "Patente/Mrd",
    type: :quantitative,
    title: "EPO-Patentanmeldungen pro Mrd. USD F&E"
  )
  |> Vl.encode_field(:color, "Land",
    type: :nominal,
    scale: [
      domain: ["Schweiz", "Schweden", "Niederlande", "Deutschland", "Österreich", "Frankreich", "USA", "Japan"],
      range: ["#a855f7", "#3b82f6", "#06b6d4", "#10b981", "#f59e0b", "#ef4444", "#6b7280", "#8b5cf6"]
    ],
    legend: nil
  )
  |> Vl.config(
    font: "Switzer, system-ui, sans-serif",
    view: [stroke: "transparent"]
  )
```

## Konzentration: Wer dominiert die F&E?

```elixir
# Sektorkonzentration im neuesten Jahr
concentration_data =
  df_latest
  |> DF.to_rows()
  |> Enum.map(fn row -> %{"Sektor" => row["Sektor"], "Ausgaben" => row["Ausgaben_Mio_CHF"]} end)

total_latest = Enum.map(concentration_data, & &1["Ausgaben"]) |> Enum.sum()
top2 = concentration_data |> Enum.take(2) |> Enum.map(& &1["Ausgaben"]) |> Enum.sum()
top2_pct = Float.round(top2 / total_latest * 100, 1)

chart_konzentration =
  Vl.new(
    width: 720,
    height: 400,
    title: "F&E-Ausgaben nach Sektor — #{latest_year} (ohne Total-Zeilen)"
  )
  |> Vl.data_from_values(concentration_data)
  |> Vl.mark(:bar, corner_radius_end: 4)
  |> Vl.encode_field(:y, "Sektor", type: :nominal, title: nil, sort: "-x")
  |> Vl.encode_field(:x, "Ausgaben", type: :quantitative, title: "Mio. CHF")
  |> Vl.encode(:color, value: "#a855f7")
  |> Vl.config(
    font: "Switzer, system-ui, sans-serif",
    view: [stroke: "transparent"]
  )
```

## Kernaussage

```elixir
latest_ratio = List.last(ratio_data)
first_ratio = hd(ratio_data)

Kino.Markdown.new("""
### Kernaussage

Die Schweiz gibt **#{Float.round(total_latest / 1000, 1)} Mrd. CHF** jährlich für
F&E aus (#{latest_year}) — davon entfällt das #{latest_ratio["Verhältnis"]}-Fache
auf die Privatwirtschaft gegenüber der öffentlichen Hand.

**Konzentration**: Die zwei grössten Sektoren (Pharma + Hochschulen) vereinen
**#{top2_pct}%** der Gesamtausgaben.

**Effizienz**: Mit **182 EPO-Patenten pro Milliarde F&E** ist die Schweiz
weltweit führend — deutlich vor Deutschland (87) und den USA (37).

Das Verhältnis Privat/Öffentlich hat sich von #{first_ratio["Verhältnis"]} (#{hd(years)})
auf #{latest_ratio["Verhältnis"]} (#{latest_year}) entwickelt.
Die Frage bleibt offen: Was fliesst als öffentlicher Ertrag aus
öffentlich finanzierter Forschung zurück?
""")
```

