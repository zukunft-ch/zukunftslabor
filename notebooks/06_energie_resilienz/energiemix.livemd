# Energie & Resilienz: Stressszenarien für die Schweizer Stromversorgung

```elixir
Mix.install([
  {:explorer, "~> 0.11"},
  {:vega_lite, "~> 0.1"},
  {:kino_vega_lite, "~> 0.1"},
  {:kino_explorer, "~> 0.1"},
  {:kino, "~> 0.14"},
  {:jason, "~> 1.4"},
  {:vega_lite_convert, "~> 1.0"},
  {:toml, "~> 0.7"},
  {:req, "~> 0.5"}
])
```

## Fragestellung

> Was passiert mit der Schweizer Stromversorgung unter Stress —
> Trockenheit plus Atomausstieg?

**Kategorie**: Datenbriefing
**Evidenzstärke**: stark (amtliche BFE-Elektrizitätsstatistik)
**Ergebnis**: Daten sprechen (Ingenieuranalyse)

## Daten laden

```elixir
alias Explorer.DataFrame, as: DF
alias Explorer.Series
alias VegaLite, as: Vl

# Elektrizitätsbilanz (BFE OGD): Jahr × Quelle × GWh
df_elec = Zukunftslabor.DataLoader.load("elektrizitaet_produktion")

# Endenergieverbrauch nach Sektor (BFE OGD): Jahr × Sektor × TJ
df_energy = Zukunftslabor.DataLoader.load("energieverbrauch_sektor")
```

## Schweizer Strommix (reale BFE-Daten)

```elixir
# Produktionsquellen für Stacked Area
production_sources = [
  "Laufkraftwerke", "Speicherkraftwerke", "Kernkraftwerke",
  "Photovoltaik", "Wind", "Andere Erneuerbare + Abfälle"
]

# Nur ab 2000 (davor fehlen Aufschlüsselungen)
mix_data =
  df_elec
  |> DF.to_rows()
  |> Enum.filter(fn row ->
    row["Quelle"] in production_sources and row["Jahr"] >= 2000
  end)

chart_strommix =
  Vl.new(
    width: 720,
    height: 420,
    title: "Schweizer Elektrizitätsproduktion nach Quelle (2000–2024, BFE)"
  )
  |> Vl.data_from_values(mix_data)
  |> Vl.mark(:area, opacity: 0.85)
  |> Vl.encode_field(:x, "Jahr", type: :ordinal, title: "Jahr")
  |> Vl.encode_field(:y, "GWh",
    type: :quantitative,
    title: "Produktion (GWh)",
    stack: :zero
  )
  |> Vl.encode_field(:color, "Quelle",
    type: :nominal,
    scale: [
      domain: production_sources,
      range: ["#3b82f6", "#06b6d4", "#f59e0b", "#a855f7", "#10b981", "#6b7280"]
    ]
  )
  |> Vl.config(
    font: "Switzer, system-ui, sans-serif",
    view: [stroke: "transparent"]
  )
```

## Endenergieverbrauch nach Sektor

```elixir
# Sektoren ohne "Total" und "Stat. Differenz"
sector_data =
  df_energy
  |> DF.to_rows()
  |> Enum.filter(fn row ->
    row["Sektor"] not in ["Total", "Stat. Differenz inkl. Landwirtschaft"] and
    row["Jahr"] >= 2000
  end)

chart_verbrauch =
  Vl.new(
    width: 720,
    height: 400,
    title: "Endenergieverbrauch nach Sektor — Schweiz (2000–2024, BFE)"
  )
  |> Vl.data_from_values(sector_data)
  |> Vl.mark(:area, opacity: 0.8)
  |> Vl.encode_field(:x, "Jahr", type: :ordinal, title: "Jahr")
  |> Vl.encode_field(:y, "Verbrauch_TJ",
    type: :quantitative,
    title: "Endenergieverbrauch (TJ)",
    stack: :zero
  )
  |> Vl.encode_field(:color, "Sektor",
    type: :nominal,
    scale: [
      domain: ["Verkehr", "Haushalte", "Industrie", "Dienstleistungen"],
      range: ["#ef4444", "#3b82f6", "#f59e0b", "#10b981"]
    ]
  )
  |> Vl.config(
    font: "Switzer, system-ui, sans-serif",
    view: [stroke: "transparent"]
  )
```

## Stressszenarien: Was passiert bei Trockenheit + Atomausstieg?

```elixir
# Letzte verfügbare Jahreswerte aus der Elektrizitätsbilanz
latest_elec_year =
  df_elec |> DF.pull("Jahr") |> Series.max()

latest_by_source =
  df_elec
  |> DF.filter(col("Jahr") == ^latest_elec_year)
  |> DF.to_rows()
  |> Map.new(fn row -> {row["Quelle"], row["GWh"]} end)

hydro = Map.get(latest_by_source, "Laufkraftwerke", 0) +
        Map.get(latest_by_source, "Speicherkraftwerke", 0)
nuclear = Map.get(latest_by_source, "Kernkraftwerke", 0)
solar = Map.get(latest_by_source, "Photovoltaik", 0)
wind = Map.get(latest_by_source, "Wind", 0)
other = Map.get(latest_by_source, "Andere Erneuerbare + Abfälle", 0) +
        Map.get(latest_by_source, "Fossile Erzeugung", 0)
consumption = Map.get(latest_by_source, "Landesverbrauch", 0)
pump = Map.get(latest_by_source, "Speicherpumpen", 0)

total_production = hydro + nuclear + solar + wind + other - pump

IO.puts("Produktion #{latest_elec_year}:")
IO.puts("  Wasserkraft:   #{hydro} GWh (#{Float.round(hydro / total_production * 100, 1)}%)")
IO.puts("  Kernkraft:     #{nuclear} GWh (#{Float.round(nuclear / total_production * 100, 1)}%)")
IO.puts("  Solar:         #{solar} GWh")
IO.puts("  Wind:          #{wind} GWh")
IO.puts("  Andere:        #{other} GWh")
IO.puts("  Pumpspeicher:  -#{pump} GWh")
IO.puts("  ──────────────────")
IO.puts("  Nettoproduktion: #{total_production} GWh")
IO.puts("  Landesverbrauch: #{consumption} GWh")

# 4 Szenarien
scenarios = [
  %{
    "Szenario" => "A: Baseline",
    "Produktion" => total_production,
    "Lücke" => max(consumption - total_production, 0),
    "order" => 0
  },
  %{
    "Szenario" => "B: Trockenjahr (-30% Hydro)",
    "Produktion" => round(total_production - hydro * 0.30),
    "Lücke" => max(consumption - (total_production - hydro * 0.30), 0) |> round(),
    "order" => 1
  },
  %{
    "Szenario" => "C: Atomausstieg",
    "Produktion" => total_production - nuclear,
    "Lücke" => max(consumption - (total_production - nuclear), 0),
    "order" => 2
  },
  %{
    "Szenario" => "D: Trockenjahr + Atomausstieg",
    "Produktion" => round(total_production - nuclear - hydro * 0.30),
    "Lücke" => max(consumption - (total_production - nuclear - hydro * 0.30), 0) |> round(),
    "order" => 3
  }
]

# Chart-Daten: gestapelte Balken (Produktion + Lücke = Verbrauch)
scenario_chart_data =
  Enum.flat_map(scenarios, fn s ->
    [
      %{"Szenario" => s["Szenario"], "Typ" => "Eigenproduktion", "GWh" => s["Produktion"], "order" => s["order"]},
      %{"Szenario" => s["Szenario"], "Typ" => "Importlücke", "GWh" => s["Lücke"], "order" => s["order"]}
    ]
  end)

chart_szenarien =
  Vl.new(
    width: 720,
    height: 400,
    title: "Stressszenarien: Eigenproduktion vs. Importlücke (#{latest_elec_year}er Basis)"
  )
  |> Vl.data_from_values(scenario_chart_data)
  |> Vl.mark(:bar, corner_radius_end: 3)
  |> Vl.encode_field(:x, "Szenario",
    type: :nominal,
    sort: [field: "order"],
    title: nil,
    axis: [label_angle: -15]
  )
  |> Vl.encode_field(:y, "GWh",
    type: :quantitative,
    title: "GWh",
    stack: :zero
  )
  |> Vl.encode_field(:color, "Typ",
    type: :nominal,
    scale: [
      domain: ["Eigenproduktion", "Importlücke"],
      range: ["#3b82f6", "#ef4444"]
    ]
  )
  |> Vl.config(
    font: "Switzer, system-ui, sans-serif",
    view: [stroke: "transparent"]
  )
```

## Importkosten der Lücke

```elixir
# Europäische Spotpreise: ~EUR 80–100/MWh (Durchschnitt 2023–2024)
# CHF/EUR: ~0.95
eur_spot_price = 90  # EUR/MWh
chf_per_eur = 0.95
chf_per_mwh = eur_spot_price / chf_per_eur

cost_data =
  Enum.map(scenarios, fn s ->
    cost_mio = Float.round(s["Lücke"] * 1000 * chf_per_mwh / 1_000_000_000, 2)
    import_pct = if consumption > 0, do: Float.round(s["Lücke"] / consumption * 100, 1), else: 0.0

    %{
      "Szenario" => s["Szenario"],
      "Importlücke GWh" => s["Lücke"],
      "Importabhängigkeit %" => import_pct,
      "Kosten Mrd. CHF" => cost_mio,
      "order" => s["order"]
    }
  end)

chart_kosten =
  Vl.new(
    width: 720,
    height: 350,
    title: "Geschätzte Importkosten pro Szenario (bei #{eur_spot_price} EUR/MWh)"
  )
  |> Vl.data_from_values(cost_data)
  |> Vl.mark(:bar, corner_radius_end: 4)
  |> Vl.encode_field(:x, "Szenario",
    type: :nominal,
    sort: [field: "order"],
    title: nil,
    axis: [label_angle: -15]
  )
  |> Vl.encode_field(:y, "Kosten Mrd. CHF",
    type: :quantitative,
    title: "Importkosten (Mrd. CHF/Jahr)"
  )
  |> Vl.encode_field(:color, "Szenario",
    type: :nominal,
    scale: [
      domain: Enum.map(scenarios, & &1["Szenario"]),
      range: ["#6b7280", "#f59e0b", "#3b82f6", "#ef4444"]
    ],
    legend: nil
  )
  |> Vl.config(
    font: "Switzer, system-ui, sans-serif",
    view: [stroke: "transparent"]
  )
```

## Kernaussage

```elixir
scenario_d = List.last(scenarios)
cost_d = List.last(cost_data)

Kino.Markdown.new("""
### Kernaussage

Die Schweiz produziert #{total_production} GWh Strom (#{latest_elec_year}) — davon
**#{Float.round(hydro / total_production * 100, 0)}% Wasserkraft** und
**#{Float.round(nuclear / total_production * 100, 0)}% Kernkraft**.

Vier Stressszenarien zeigen die Verwundbarkeit:

| Szenario | Importlücke | Abhängigkeit | Kosten |
|---|---|---|---|
| **A: Baseline** | #{hd(scenarios)["Lücke"]} GWh | #{hd(cost_data)["Importabhängigkeit %"]}% | #{hd(cost_data)["Kosten Mrd. CHF"]} Mrd. |
| **B: Trockenjahr** | #{Enum.at(scenarios, 1)["Lücke"]} GWh | #{Enum.at(cost_data, 1)["Importabhängigkeit %"]}% | #{Enum.at(cost_data, 1)["Kosten Mrd. CHF"]} Mrd. |
| **C: Atomausstieg** | #{Enum.at(scenarios, 2)["Lücke"]} GWh | #{Enum.at(cost_data, 2)["Importabhängigkeit %"]}% | #{Enum.at(cost_data, 2)["Kosten Mrd. CHF"]} Mrd. |
| **D: Beides** | #{scenario_d["Lücke"]} GWh | #{cost_d["Importabhängigkeit %"]}% | #{cost_d["Kosten Mrd. CHF"]} Mrd. |

Im Worst Case (Trockenjahr + Atomausstieg) müsste die Schweiz
**#{cost_d["Importabhängigkeit %"]}%** ihres Strombedarfs importieren —
Kosten: **#{cost_d["Kosten Mrd. CHF"]} Mrd. CHF/Jahr** bei aktuellen Spotpreisen.

Resilienz ist Ingenieurwesen, nicht Ideologie.
""")
```

