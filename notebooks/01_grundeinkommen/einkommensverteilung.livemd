# Grundeinkommen: Drei Finanzierungsmodelle im Vergleich

```elixir
Mix.install([
  {:explorer, "~> 0.11"},
  {:vega_lite, "~> 0.1"},
  {:kino_vega_lite, "~> 0.1"},
  {:kino_explorer, "~> 0.1"},
  {:kino, "~> 0.14"},
  {:jason, "~> 1.4"},
  {:vega_lite_convert, "~> 1.0"},
  {:toml, "~> 0.7"},
  {:req, "~> 0.5"}
])
```

## Fragestellung

> Drei Wege, ein bedingungsloses Grundeinkommen zu finanzieren —
> was macht jeder davon mit der Einkommensverteilung?

**Kategorie**: Datenbriefing
**Evidenzstärke**: mittel (öffentlich aggregierte BFS-Daten, Dezil-Mikrosimulation)
**Ergebnis**: Daten sprechen — keine Parteiposition

## Daten laden

```elixir
alias Explorer.DataFrame, as: DF
alias Explorer.Series

df_all = Zukunftslabor.DataLoader.load("einkommensverteilung_silc")
```

```elixir
# Neuestes Jahr verwenden (2018 — letzte BFS-HABE-Publikation)
df_2018 = df_all |> DF.filter(col("Jahr") == 2018)

# Dezilanteile extrahieren
decile_rows =
  df_2018
  |> DF.filter(contains(col("Kennzahl"), "Dezil"))
  |> DF.to_rows()
  |> Enum.map(fn row ->
    dezil =
      row["Kennzahl"]
      |> String.replace("Dezil_", "")
      |> String.replace("_Anteil_Prozent", "")
      |> String.to_integer()

    %{"Dezil" => dezil, "Anteil" => row["Wert"]}
  end)
  |> Enum.sort_by(& &1["Dezil"])

# Gini, Median, Mittelwert
gini_bfs =
  df_2018
  |> DF.filter(col("Kennzahl") == "Gini_Koeffizient")
  |> DF.pull("Wert")
  |> Series.to_list()
  |> hd()

mean_monthly =
  df_2018
  |> DF.filter(col("Kennzahl") == "Mittelwert_CHF_Monat")
  |> DF.pull("Wert")
  |> Series.to_list()
  |> hd()

median_monthly =
  df_2018
  |> DF.filter(col("Kennzahl") == "Median_CHF_Monat")
  |> DF.pull("Wert")
  |> Series.to_list()
  |> hd()
  |> round()

IO.puts("Gini (2018): #{gini_bfs}")
IO.puts("Mittelwert: CHF #{round(mean_monthly)}/Monat")
IO.puts("Median: CHF #{median_monthly}/Monat")
```

## Baseline: Einkommensverteilung nach Dezilen

```elixir
alias VegaLite, as: Vl

chart_baseline =
  Vl.new(
    width: 720,
    height: 400,
    title: "Einkommensanteile nach Dezil — Verfügbares Äquivalenzeinkommen (2018)"
  )
  |> Vl.data_from_values(decile_rows)
  |> Vl.mark(:bar, corner_radius_end: 4)
  |> Vl.encode_field(:x, "Dezil", type: :ordinal, title: "Einkommensdezil")
  |> Vl.encode_field(:y, "Anteil", type: :quantitative, title: "Anteil am Gesamteinkommen (%)")
  |> Vl.encode(:color, value: "#a855f7")
  |> Vl.config(
    font: "Switzer, system-ui, sans-serif",
    view: [stroke: "transparent"]
  )
```

## Drei Finanzierungsszenarien

```elixir
# ── Parameter ──────────────────────────────────────────────────────
ubi_monthly = 2500

# Schweizer Bevölkerung (2018): ~8.54 Mio
# Erwachsene (18+): ~7.0 Mio
# Kinder (<18): ~1.54 Mio (Kindersatz: CHF 625/Mt = 25% des Erwachsenenbetrags)
adults = 7_000_000
children = 1_540_000
child_rate = 625

# Bruttokosten UBI pro Jahr
gross_cost_bn = (adults * ubi_monthly + children * child_rate) * 12 / 1_000_000_000
IO.puts("Bruttokosten UBI: CHF #{Float.round(gross_cost_bn, 1)} Mrd./Jahr")

# ── Absolute Einkommen pro Dezil schätzen ──────────────────────────
# Jedes Dezil = 10% der Bevölkerung, Anteil × Mittelwert × 10
decile_incomes =
  Enum.map(decile_rows, fn row ->
    monthly = row["Anteil"] / 100 * mean_monthly * 10
    %{"Dezil" => row["Dezil"], "Einkommen_SQ" => round(monthly)}
  end)

IO.puts("\nGeschätztes Monatseinkommen pro Dezil (Status quo):")

Enum.each(decile_incomes, fn d ->
  IO.puts("  D#{d["Dezil"]}: CHF #{d["Einkommen_SQ"]}")
end)
```

### Szenario A — Pauschale Einkommensteuer

```elixir
# Szenario A: Flat income tax surcharge
# Gesamtkosten = CHF ~222 Mrd./Jahr
# BIP Schweiz 2018: ~CHF 700 Mrd.
# Gesamtes Haushaltseinkommen ≈ Mittelwert × 12 × Bevölkerung
total_income_bn = mean_monthly * 12 * (adults + children) / 1_000_000_000

# Pauschaler Steuersatz = Kosten / Gesamteinkommen
tax_rate_a = gross_cost_bn / total_income_bn
IO.puts("Szenario A — pauschaler Steuerzuschlag: #{Float.round(tax_rate_a * 100, 1)}%")

scenario_a =
  Enum.map(decile_incomes, fn d ->
    netto = d["Einkommen_SQ"] * (1 - tax_rate_a) + ubi_monthly
    veraenderung = netto - d["Einkommen_SQ"]

    %{
      "Dezil" => d["Dezil"],
      "Einkommen_SQ" => d["Einkommen_SQ"],
      "Netto" => round(netto),
      "Veraenderung" => round(veraenderung),
      "Szenario" => "A: Einkommensteuer"
    }
  end)
```

### Szenario B — Ablösung bestehender Transfers

```elixir
# Szenario B: Bestehende Sozialtransfers ersetzen
# AHV: ~48 Mrd., IV: ~10 Mrd., EL: ~5 Mrd., Sozialhilfe: ~3 Mrd.,
# ALV: ~7 Mrd., Familienzulagen: ~6 Mrd.
# Total abgelöst: ~CHF 79 Mrd.
transfers_replaced_bn = 79.0
remaining_cost_bn = gross_cost_bn - transfers_replaced_bn

tax_rate_b = remaining_cost_bn / total_income_bn
IO.puts("Szenario B — erspartes Transfer-Volumen: CHF #{transfers_replaced_bn} Mrd.")
IO.puts("Szenario B — verbleibender Steuerzuschlag: #{Float.round(tax_rate_b * 100, 1)}%")

# Geschätzte aktuelle Transfereinkommen pro Dezil (CHF/Monat)
# D1–D3 erhalten überproportional viele Transfers (AHV, EL, Sozialhilfe)
# Basierend auf BFS-Transferverteilung (SILC-Mikrodaten, publizierte Anteile)
transfers_by_decile = %{
  1 => 2900,
  2 => 2200,
  3 => 1700,
  4 => 1300,
  5 => 1000,
  6 => 750,
  7 => 550,
  8 => 400,
  9 => 250,
  10 => 100
}

scenario_b =
  Enum.map(decile_incomes, fn d ->
    current_transfers = Map.get(transfers_by_decile, d["Dezil"], 0)
    # Verliert bestehende Transfers, gewinnt UBI, zahlt Steuer
    netto =
      (d["Einkommen_SQ"] - current_transfers) * (1 - tax_rate_b) + ubi_monthly

    veraenderung = round(netto) - d["Einkommen_SQ"]

    %{
      "Dezil" => d["Dezil"],
      "Einkommen_SQ" => d["Einkommen_SQ"],
      "Netto" => round(netto),
      "Veraenderung" => round(veraenderung),
      "Szenario" => "B: Transferablösung",
      "Transfers_verloren" => current_transfers
    }
  end)

# Kernbefund: Welche Dezile verlieren?
verlierer_b =
  scenario_b
  |> Enum.filter(fn d -> d["Veraenderung"] < 0 end)
  |> Enum.map(fn d -> "D#{d["Dezil"]} (#{d["Veraenderung"]} CHF)" end)

if verlierer_b != [] do
  IO.puts("\n⚠ Verlierer in Szenario B: #{Enum.join(verlierer_b, ", ")}")
  IO.puts("Grund: Bestehende Transfers > UBI-Betrag")
else
  IO.puts("\nKeine Dezile schlechter gestellt in Szenario B")
end
```

### Szenario C — Konsumsteuer (MwSt.-Zuschlag)

```elixir
# Szenario C: Finanzierung über Konsumsteuer (MwSt.-Zuschlag)
# Untere Dezile konsumieren ~90–95% des Einkommens
# Obere Dezile konsumieren ~55–65% (Rest = Sparen)

consumption_share = %{
  1 => 0.95,
  2 => 0.92,
  3 => 0.88,
  4 => 0.85,
  5 => 0.80,
  6 => 0.75,
  7 => 0.70,
  8 => 0.65,
  9 => 0.60,
  10 => 0.55
}

# Gesamtkonsum (gewichtete Summe über Dezile)
total_consumption_monthly =
  Enum.reduce(decile_incomes, 0.0, fn d, acc ->
    share = Map.get(consumption_share, d["Dezil"], 0.75)
    acc + d["Einkommen_SQ"] * share
  end)

# Pro Kopf × Bevölkerung → Jahreskonsum
total_consumption_bn = total_consumption_monthly * (adults + children) / 10 * 12 / 1_000_000_000

# MwSt.-Zuschlag nötig
vat_surcharge = gross_cost_bn / total_consumption_bn
IO.puts("Szenario C — MwSt.-Zuschlag: #{Float.round(vat_surcharge * 100, 1)}%")

scenario_c =
  Enum.map(decile_incomes, fn d ->
    share = Map.get(consumption_share, d["Dezil"], 0.75)
    konsum = d["Einkommen_SQ"] * share
    steuer = konsum * vat_surcharge
    netto = d["Einkommen_SQ"] - steuer + ubi_monthly
    veraenderung = round(netto) - d["Einkommen_SQ"]

    %{
      "Dezil" => d["Dezil"],
      "Einkommen_SQ" => d["Einkommen_SQ"],
      "Netto" => round(netto),
      "Veraenderung" => round(veraenderung),
      "Szenario" => "C: Konsumsteuer"
    }
  end)
```

## Gini-Berechnung pro Szenario

```elixir
defmodule GiniCalc do
  @doc "Berechnet Gini-Koeffizienten aus einer Liste von Einkommen (Trapezregel auf Lorenzkurve)."
  def gini(incomes) do
    sorted = Enum.sort(incomes)
    n = length(sorted)
    total = Enum.sum(sorted)

    if total == 0 do
      0.0
    else
      cumulative = sorted |> Enum.scan(&(&1 + &2))
      lorenz = Enum.map(cumulative, &(&1 / total))

      area =
        lorenz
        |> Enum.with_index(1)
        |> Enum.reduce(0.0, fn {y, i}, acc ->
          x_prev = (i - 1) / n
          x_curr = i / n
          y_prev = if i == 1, do: 0.0, else: Enum.at(lorenz, i - 2)
          acc + (x_curr - x_prev) * (y + y_prev) / 2
        end)

      Float.round(1.0 - 2.0 * area, 4)
    end
  end
end

incomes_sq = Enum.map(decile_incomes, & &1["Einkommen_SQ"])
gini_sq = GiniCalc.gini(incomes_sq)
gini_a = GiniCalc.gini(Enum.map(scenario_a, & &1["Netto"]))
gini_b = GiniCalc.gini(Enum.map(scenario_b, & &1["Netto"]))
gini_c = GiniCalc.gini(Enum.map(scenario_c, & &1["Netto"]))

IO.puts("Gini BFS (2018):       #{gini_bfs}")
IO.puts("Gini simuliert (SQ):   #{gini_sq}")
IO.puts("Gini Szenario A:       #{gini_a}")
IO.puts("Gini Szenario B:       #{gini_b}")
IO.puts("Gini Szenario C:       #{gini_c}")
```

## Visualisierung: Szenarien-Vergleich

```elixir
# Chart 2: Nettoveränderung pro Dezil × 3 Szenarien (gruppierter Balken)
comparison_data =
  (scenario_a ++ scenario_b ++ scenario_c)
  |> Enum.map(fn d ->
    %{
      "Dezil" => d["Dezil"],
      "Veränderung CHF/Mt" => d["Veraenderung"],
      "Szenario" => d["Szenario"]
    }
  end)

chart_szenarien =
  Vl.new(
    width: 720,
    height: 420,
    title: "Nettoveränderung des Monatseinkommens pro Dezil — drei Finanzierungsmodelle"
  )
  |> Vl.data_from_values(comparison_data)
  |> Vl.mark(:bar, corner_radius_end: 3)
  |> Vl.encode_field(:x, "Dezil", type: :ordinal, title: "Einkommensdezil")
  |> Vl.encode_field(:y, "Veränderung CHF/Mt",
    type: :quantitative,
    title: "Nettoveränderung (CHF/Monat)"
  )
  |> Vl.encode_field(:color, "Szenario",
    type: :nominal,
    scale: [range: ["#a855f7", "#3b82f6", "#06b6d4"]],
    legend: [orient: "top"]
  )
  |> Vl.encode_field(:x_offset, "Szenario", type: :nominal)
  |> Vl.config(
    font: "Switzer, system-ui, sans-serif",
    view: [stroke: "transparent"]
  )
```

## Visualisierung: Gini-Vergleich

```elixir
# Chart 3: Gini-Koeffizient pro Szenario (Balkendiagramm)
gini_data = [
  %{"Szenario" => "Status quo", "Gini" => gini_sq, "order" => 0},
  %{"Szenario" => "A: Einkommensteuer", "Gini" => gini_a, "order" => 1},
  %{"Szenario" => "B: Transferablösung", "Gini" => gini_b, "order" => 2},
  %{"Szenario" => "C: Konsumsteuer", "Gini" => gini_c, "order" => 3}
]

chart_gini =
  Vl.new(
    width: 720,
    height: 300,
    title: "Gini-Koeffizient nach Finanzierungsszenario"
  )
  |> Vl.data_from_values(gini_data)
  |> Vl.mark(:bar, corner_radius_end: 4)
  |> Vl.encode_field(:x, "Szenario",
    type: :nominal,
    sort: [field: "order"],
    title: nil
  )
  |> Vl.encode_field(:y, "Gini",
    type: :quantitative,
    title: "Gini-Koeffizient",
    scale: [domain: [0.0, 0.35]]
  )
  |> Vl.encode_field(:color, "Szenario",
    type: :nominal,
    scale: [
      domain: ["Status quo", "A: Einkommensteuer", "B: Transferablösung", "C: Konsumsteuer"],
      range: ["#6b7280", "#a855f7", "#3b82f6", "#06b6d4"]
    ],
    legend: nil
  )
  |> Vl.config(
    font: "Switzer, system-ui, sans-serif",
    view: [stroke: "transparent"]
  )
```

## Visualisierung: Gewinner und Verlierer

```elixir
# Chart 4: Gewinner/Verlierer-Analyse — wer profitiert, wer verliert?
gv_data =
  Enum.flat_map(["A: Einkommensteuer", "B: Transferablösung", "C: Konsumsteuer"], fn szenario ->
    source =
      case szenario do
        "A: Einkommensteuer" -> scenario_a
        "B: Transferablösung" -> scenario_b
        "C: Konsumsteuer" -> scenario_c
      end

    Enum.map(source, fn d ->
      %{
        "Dezil" => d["Dezil"],
        "Szenario" => szenario,
        "Veränderung %" =>
          if d["Einkommen_SQ"] > 0 do
            Float.round(d["Veraenderung"] / d["Einkommen_SQ"] * 100, 1)
          else
            0.0
          end
      }
    end)
  end)

chart_gewinner =
  Vl.new(
    width: 720,
    height: 400,
    title: "Relative Einkommensveränderung nach Dezil und Szenario"
  )
  |> Vl.data_from_values(gv_data)
  |> Vl.mark(:line, point: [size: 60], stroke_width: 2)
  |> Vl.encode_field(:x, "Dezil", type: :ordinal, title: "Einkommensdezil")
  |> Vl.encode_field(:y, "Veränderung %",
    type: :quantitative,
    title: "Relative Veränderung (%)"
  )
  |> Vl.encode_field(:color, "Szenario",
    type: :nominal,
    scale: [range: ["#a855f7", "#3b82f6", "#06b6d4"]],
    legend: [orient: "top"]
  )
  |> Vl.encode_field(:stroke_dash, "Szenario", type: :nominal, legend: nil)
  |> Vl.config(
    font: "Switzer, system-ui, sans-serif",
    view: [stroke: "transparent"]
  )
```

## Kernaussage

```elixir
d1_pct_a = hd(gv_data)["Veränderung %"]
d10_change_a = List.last(scenario_a)["Veraenderung"]

verlierer_count_b =
  scenario_b
  |> Enum.count(fn d -> d["Veraenderung"] < 0 end)

Kino.Markdown.new("""
### Kernaussage

Drei Finanzierungsmodelle für ein UBI von **CHF 2'500/Mt** erzeugen
grundlegend unterschiedliche Verteilungswirkungen:

**A — Pauschale Einkommensteuer (#{Float.round(tax_rate_a * 100, 1)}% Zuschlag):**
Alle Dezile unter dem Durchschnitt profitieren netto.
D1 gewinnt relativ am meisten (+#{d1_pct_a}%), D10 verliert CHF #{abs(d10_change_a)}/Mt.
Gini sinkt von #{gini_sq} auf #{gini_a}.

**B — Transferablösung (AHV/IV/EL/Sozialhilfe + #{Float.round(tax_rate_b * 100, 1)}% Steuer):**
#{if verlierer_count_b > 0, do: "**#{verlierer_count_b} Dezil(e) stehen schlechter da** — bestehende Transfers übersteigen den UBI-Betrag.", else: "Alle Dezile profitieren."}
Das ist der nicht-triviale Befund: Ein UBI als Ersatz ist für die Ärmsten
nicht automatisch besser.

**C — Konsumsteuer (#{Float.round(vat_surcharge * 100, 1)}% MwSt.-Zuschlag):**
Progressiv im Netto (untere Dezile konsumieren mehr, sparen weniger),
aber weniger umverteilend als Szenario A. Gini: #{gini_c}.

**Einschränkungen**: Dezilbasierte Simulation ohne Individualdaten.
Keine Verhaltensanpassungen. Transferschätzungen basieren auf
publizierten BFS-Verteilungsanteilen (nicht Mikrodaten).
""")
```

