# Automatisierungsrisiko: Wie KI die Risikolandkarte verschiebt

```elixir
Mix.install([
  {:explorer, "~> 0.11"},
  {:vega_lite, "~> 0.1"},
  {:kino_vega_lite, "~> 0.1"},
  {:kino_explorer, "~> 0.1"},
  {:kino, "~> 0.14"},
  {:jason, "~> 1.4"},
  {:vega_lite_convert, "~> 1.0"},
  {:toml, "~> 0.7"},
  {:req, "~> 0.5"}
])
```

## Fragestellung

> Welche Schweizer Branchen sind am stärksten exponiert — und wie hat
> KI die Risikolandkarte verschoben?

**Kategorie**: Datenbriefing
**Evidenzstärke**: mittel (BFS-Beschäftigungsdaten + OECD/IMF-Risikoschätzungen)
**Ergebnis**: Daten sprechen

## Daten laden

```elixir
alias Explorer.DataFrame, as: DF
alias Explorer.Series
alias VegaLite, as: Vl

df_emp = Zukunftslabor.DataLoader.load("erwerbstaetige_sake")

latest_year = df_emp |> DF.pull("Jahr") |> Series.max()

df_latest =
  df_emp
  |> DF.filter(col("Jahr") == ^latest_year and col("Sektor") != "Total")
  |> DF.sort_by(desc: col("Erwerbstaetige"))

emp_data =
  df_latest
  |> DF.to_rows()
  |> Enum.map(fn row ->
    %{"Sektor" => row["Bezeichnung"], "Code" => row["Sektor"], "Erwerbstätige" => row["Erwerbstaetige"]}
  end)

IO.puts("Neuestes Jahr: #{latest_year}, #{length(emp_data)} Sektoren")
```

## Beschäftigungslandschaft

```elixir
chart_beschaeftigung =
  Vl.new(
    width: 720,
    height: 450,
    title: "Erwerbstätige nach Wirtschaftsabschnitt — Schweiz (#{latest_year}, in Tsd.)"
  )
  |> Vl.data_from_values(emp_data)
  |> Vl.mark(:bar, corner_radius_end: 4)
  |> Vl.encode_field(:y, "Sektor", type: :nominal, title: nil, sort: "-x")
  |> Vl.encode_field(:x, "Erwerbstätige", type: :quantitative, title: "Erwerbstätige (Tsd.)")
  |> Vl.encode(:color, value: "#a855f7")
  |> Vl.config(font: "Switzer, system-ui, sans-serif", view: [stroke: "transparent"])
```

## Pre-LLM vs. Post-LLM Automatisierungsrisiko

```elixir
# OECD 2018: Risiko basiert auf Routinetätigkeiten (Frey/Osborne)
# IMF 2024: KI-Exposition basiert auf kognitive Aufgaben + LLM-Fähigkeiten
risk_data = [
  %{s: "Verarbeitendes Gewerbe, Bergbau",   code: "B-C", pre: 35, post: 28, dir: "↓"},
  %{s: "Handel, Reparatur",                  code: "G",   pre: 28, post: 32, dir: "↑"},
  %{s: "Gastgewerbe, Beherbergung",          code: "I",   pre: 42, post: 30, dir: "↓"},
  %{s: "Verkehr, Lagerei",                   code: "H",   pre: 38, post: 25, dir: "↓"},
  %{s: "Finanz-, Versicherungsdienstl.",     code: "K",   pre: 22, post: 45, dir: "↑"},
  %{s: "Gesundheits-, Sozialwesen",          code: "Q",   pre: 12, post: 18, dir: "↑"},
  %{s: "Information, Kommunikation",         code: "J",   pre: 8,  post: 35, dir: "↑"},
  %{s: "Baugewerbe",                         code: "F",   pre: 25, post: 15, dir: "↓"},
  %{s: "Erziehung und Unterricht",           code: "P",   pre: 5,  post: 15, dir: "↑"},
  %{s: "Öffentliche Verwaltung",             code: "O",   pre: 15, post: 28, dir: "↑"},
  %{s: "Freiberufliche, wiss. Dienstl.",     code: "M",   pre: 10, post: 38, dir: "↑"},
  %{s: "Sonstige wirtsch. Dienstl.",         code: "N",   pre: 30, post: 22, dir: "↓"},
  %{s: "Grundstücks-, Wohnungswesen",        code: "L",   pre: 18, post: 25, dir: "↑"}
]

dumbbell_data =
  Enum.flat_map(risk_data, fn r ->
    [
      %{"Sektor" => r.s, "Modell" => "Pre-LLM (OECD 2018)", "Hohes Risiko %" => r.pre},
      %{"Sektor" => r.s, "Modell" => "Post-LLM (IMF 2024)", "Hohes Risiko %" => r.post}
    ]
  end)

chart_pre_post =
  Vl.new(
    width: 720,
    height: 500,
    title: "Automatisierungsrisiko: Pre-LLM (2018) vs. Post-LLM (2024)"
  )
  |> Vl.data_from_values(dumbbell_data)
  |> Vl.mark(:point, size: 100, filled: true)
  |> Vl.encode_field(:y, "Sektor", type: :nominal, title: nil, sort: "-x")
  |> Vl.encode_field(:x, "Hohes Risiko %",
    type: :quantitative,
    title: "Anteil mit hohem Automatisierungsrisiko (%)"
  )
  |> Vl.encode_field(:color, "Modell",
    type: :nominal,
    scale: [
      domain: ["Pre-LLM (OECD 2018)", "Post-LLM (IMF 2024)"],
      range: ["#6b7280", "#a855f7"]
    ]
  )
  |> Vl.config(font: "Switzer, system-ui, sans-serif", view: [stroke: "transparent"])
```

## Risikoverschiebung

```elixir
shift_data =
  risk_data
  |> Enum.map(fn r ->
    %{
      "Sektor" => r.s,
      "Verschiebung PP" => r.post - r.pre,
      "Richtung" => if(r.post > r.pre, do: "Risiko gestiegen", else: "Risiko gesunken")
    }
  end)
  |> Enum.sort_by(fn d -> d["Verschiebung PP"] end)

chart_verschiebung =
  Vl.new(
    width: 720,
    height: 450,
    title: "Risikoverschiebung durch LLM: Veränderung des Automatisierungsrisikos (PP)"
  )
  |> Vl.data_from_values(shift_data)
  |> Vl.mark(:bar, corner_radius_end: 3)
  |> Vl.encode_field(:y, "Sektor", type: :nominal, title: nil,
    sort: [field: "Verschiebung PP", order: "ascending"]
  )
  |> Vl.encode_field(:x, "Verschiebung PP",
    type: :quantitative,
    title: "Veränderung (Prozentpunkte)"
  )
  |> Vl.encode_field(:color, "Richtung",
    type: :nominal,
    scale: [
      domain: ["Risiko gestiegen", "Risiko gesunken"],
      range: ["#ef4444", "#10b981"]
    ]
  )
  |> Vl.config(font: "Switzer, system-ui, sans-serif", view: [stroke: "transparent"])
```

## Exponierte Arbeitsplätze (Post-LLM)

```elixir
exposed_data =
  risk_data
  |> Enum.map(fn r ->
    emp = Enum.find(emp_data, fn e -> e["Code"] == r.code end)
    count = if emp, do: emp["Erwerbstätige"], else: 0
    exposed = round(count * r.post / 100)
    %{"Sektor" => r.s, "Exponierte Stellen (Tsd.)" => exposed, "Risiko %" => r.post}
  end)
  |> Enum.filter(fn d -> d["Exponierte Stellen (Tsd.)"] > 0 end)
  |> Enum.sort_by(fn d -> -d["Exponierte Stellen (Tsd.)"] end)

total_exposed = Enum.map(exposed_data, & &1["Exponierte Stellen (Tsd.)"]) |> Enum.sum()

chart_exponiert =
  Vl.new(
    width: 720,
    height: 450,
    title: "Geschätzte exponierte Arbeitsplätze nach Post-LLM-Modell (Tsd.)"
  )
  |> Vl.data_from_values(exposed_data)
  |> Vl.mark(:bar, corner_radius_end: 4)
  |> Vl.encode_field(:y, "Sektor", type: :nominal, title: nil, sort: "-x")
  |> Vl.encode_field(:x, "Exponierte Stellen (Tsd.)",
    type: :quantitative,
    title: "Exponierte Stellen (Tsd.)"
  )
  |> Vl.encode(:color, value: "#ef4444")
  |> Vl.config(font: "Switzer, system-ui, sans-serif", view: [stroke: "transparent"])
```

## Kernaussage

```elixir
biggest_riser = shift_data |> Enum.max_by(& &1["Verschiebung PP"])
biggest_faller = shift_data |> Enum.min_by(& &1["Verschiebung PP"])

Kino.Markdown.new("""
### Kernaussage

LLM-fähige KI hat die Automatisierungs-Risikolandkarte **fundamental verschoben**:

- **Bürojobs rauf**: #{biggest_riser["Sektor"]} (+#{biggest_riser["Verschiebung PP"]} PP)
- **Manuelle Jobs runter**: #{biggest_faller["Sektor"]} (#{biggest_faller["Verschiebung PP"]} PP)
- **Total exponiert** (Post-LLM): ~#{total_exposed}'000 Stellen

**Einschränkungen**: Pre-LLM = OECD/Frey-Osborne 2018, Post-LLM = IMF 2024.
Tatsächliche Jobverluste hängen von Anpassungsgeschwindigkeit und Regulierung ab.
""")
```

## Export

```elixir
Zukunftslabor.ChartExport.to_svg(chart_beschaeftigung, name: "automatisierung_beschaeftigung")
Zukunftslabor.ChartExport.to_svg(chart_pre_post, name: "automatisierung_pre_post_llm")
Zukunftslabor.ChartExport.to_svg(chart_verschiebung, name: "automatisierung_risikoverschiebung")
Zukunftslabor.ChartExport.to_svg(chart_exponiert, name: "automatisierung_exponierte_stellen")

Zukunftslabor.NotizTemplate.generate(
  title: "Automatisierung: Wie KI die Risikolandkarte verschiebt",
  description:
    "LLM-fähige KI verändert das Automatisierungsrisiko: Bürojobs stärker exponiert, manuelle Arbeit weniger.",
  slug: "automatisierungsrisiko-branchen",
  category: "datenbriefing",
  evidence: "mittel",
  tags: ["automatisierung", "ki", "arbeitsmarkt", "branchen", "llm"],
  charts: [
    "automatisierung_beschaeftigung.svg",
    "automatisierung_pre_post_llm.svg",
    "automatisierung_risikoverschiebung.svg",
    "automatisierung_exponierte_stellen.svg"
  ],
  summary: """
  LLM-fähige KI verschiebt das Automatisierungsrisiko: Bürojobs (Finanz,
  Recht, Verwaltung) sind stärker exponiert als vor 2018, manuelle Berufe
  weniger. ~#{total_exposed}'000 Stellen unter Post-LLM-Risiko.
  """,
  body: """
  ## Methodik

  BFS-SAKE-Beschäftigungsdaten (#{latest_year}) und zwei Risikomodelle:
  OECD/Frey-Osborne (2018, Routinetätigkeiten) und IMF AI Preparedness
  Index (2024, LLM-Fähigkeiten). Exponierte Stellen = Beschäftigte × Risikoanteil.

  ## Ergebnisse

  ![Beschäftigung](/zukunftslabor/charts/automatisierung_beschaeftigung.svg)

  ![Pre vs. Post LLM](/zukunftslabor/charts/automatisierung_pre_post_llm.svg)

  ![Risikoverschiebung](/zukunftslabor/charts/automatisierung_risikoverschiebung.svg)

  ![Exponierte Stellen](/zukunftslabor/charts/automatisierung_exponierte_stellen.svg)

  ## Einschränkungen

  - Risikoschätzungen sind Branchendurchschnitte, nicht berufsspezifisch
  - Post-LLM-Schätzungen vorläufig (LLM-Fähigkeiten entwickeln sich schnell)
  - Tatsächliche Jobverluste hängen von Regulierung und Komplementarität ab

  ## Datenquellen

  - BFS SAKE #{latest_year}: Erwerbstätige nach Wirtschaftsabschnitt
  - OECD: Automation Risk by Occupation (Nedelkoska/Quintini 2018)
  - IMF: AI Preparedness Index 2024 (Cazzaniga et al.)
  """
)
```
