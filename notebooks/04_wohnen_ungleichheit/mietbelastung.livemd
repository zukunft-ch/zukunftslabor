])
```

## Fragestellung

> Bei aktuellen Trends — wann überschreitet jeder Kanton die
> 30%-Mietbelastungsschwelle?

**Kategorie**: Datenbriefing
**Evidenzstärke**: stark (amtliche BFS-Mietstatistik + SILC-Daten)
**Ergebnis**: Daten sprechen

## Daten laden

```elixir
alias Explorer.DataFrame, as: DF
alias Explorer.Series
alias VegaLite, as: Vl

df_mieten = Zukunftslabor.DataLoader.load("mietzinse_kantone")
df_income = Zukunftslabor.DataLoader.load("einkommensverteilung_silc")
```

## Mietbelastung nach Einkommensquintil

```elixir
burden_data = [
  %{"Quintil" => "Q1 (unterstes)", "Belastung %" => 40},
  %{"Quintil" => "Q2", "Belastung %" => 28},
  %{"Quintil" => "Q3", "Belastung %" => 22},
  %{"Quintil" => "Q4", "Belastung %" => 18},
  %{"Quintil" => "Q5 (oberstes)", "Belastung %" => 12}
]

chart_quintile =
  Vl.new(width: 720, height: 350,
    title: "Mietbelastungsquote nach Einkommensquintil (BFS SILC 2022)")
  |> Vl.data_from_values(burden_data)
  |> Vl.mark(:bar, corner_radius_end: 4)
  |> Vl.encode_field(:x, "Quintil", type: :ordinal, title: "Einkommensquintil")
  |> Vl.encode_field(:y, "Belastung %", type: :quantitative,
    title: "Mietbelastung (% des Einkommens)", scale: [domain: [0, 50]])
  |> Vl.encode_field(:color, "Quintil", type: :ordinal,
    scale: [range: ["#ef4444", "#f59e0b", "#a855f7", "#3b82f6", "#06b6d4"]], legend: nil)
  |> Vl.config(font: "Switzer, system-ui, sans-serif", view: [stroke: "transparent"])
```

## Kantonale Mietpreise

```elixir
latest_year = df_mieten |> DF.pull("Jahr") |> Series.max()

canton_data =
  df_mieten
  |> DF.filter(col("Jahr") == ^latest_year and col("Zimmerzahl") == "3 Zimmer")
  |> DF.sort_by(desc: col("Miete_CHF"))
  |> DF.to_rows()
  |> Enum.map(fn row -> %{"Kanton" => row["Kanton"], "Miete CHF" => row["Miete_CHF"]} end)

chart_kantone =
  Vl.new(width: 720, height: 600,
    title: "Durchschnittliche Miete 3-Zimmer-Wohnung nach Kanton (#{latest_year})")
  |> Vl.data_from_values(canton_data)
  |> Vl.mark(:bar, corner_radius_end: 4)
  |> Vl.encode_field(:y, "Kanton", type: :nominal, title: nil, sort: "-x")
  |> Vl.encode_field(:x, "Miete CHF", type: :quantitative, title: "CHF/Monat")
  |> Vl.encode(:color, value: "#a855f7")
  |> Vl.config(font: "Switzer, system-ui, sans-serif", view: [stroke: "transparent"])
```

## Mietpreiswachstum (CAGR)

```elixir
# Use 2010+ data — BFS survey methodology changed between 2003 and 2010,
# making pre-2010 values non-comparable (different rent definitions).
df_mieten_recent = DF.filter(df_mieten, col("Jahr") >= 2010)

years = df_mieten_recent |> DF.pull("Jahr") |> Series.distinct() |> Series.sort() |> Series.to_list()
first_year = hd(years)
last_year = List.last(years)
n_years = last_year - first_year

cagr_data =
  df_mieten_recent
  |> DF.filter(col("Zimmerzahl") == "3 Zimmer")
  |> DF.to_rows()
  |> Enum.group_by(& &1["Kanton"])
  |> Enum.reject(fn {canton, _} -> canton in ["Total", "Schweiz"] end)
  |> Enum.map(fn {canton, rows} ->
    first = Enum.find(rows, fn r -> r["Jahr"] == first_year end)
    last = Enum.find(rows, fn r -> r["Jahr"] == last_year end)
    cagr =
      if first && last && first["Miete_CHF"] > 0 && n_years > 0 do
        (:math.pow(last["Miete_CHF"] / first["Miete_CHF"], 1 / n_years) - 1) * 100
        |> Float.round(2)
      else
        0.0
      end
    %{"Kanton" => canton, "CAGR %" => cagr, "Miete_last" => last && last["Miete_CHF"]}
  end)
  |> Enum.filter(fn d -> d["CAGR %"] != 0.0 end)
  |> Enum.sort_by(fn d -> -d["CAGR %"] end)

chart_cagr =
  Vl.new(width: 720, height: 600,
    title: "Jährliches Mietpreiswachstum (CAGR) — #{first_year}–#{last_year}")
  |> Vl.data_from_values(cagr_data)
  |> Vl.mark(:bar, corner_radius_end: 4)
  |> Vl.encode_field(:y, "Kanton", type: :nominal, title: nil, sort: "-x")
  |> Vl.encode_field(:x, "CAGR %", type: :quantitative, title: "CAGR (%/Jahr)")
  |> Vl.encode(:color, value: "#ef4444")
  |> Vl.config(font: "Switzer, system-ui, sans-serif", view: [stroke: "transparent"])
```

## Schwellen-Prognose

```elixir
q1_income_monthly = 2800
income_growth_annual = 0.01
threshold = 0.30

projection_data =
  cagr_data
  |> Enum.map(fn d ->
    current_rent = d["Miete_last"] || 0
    rent_cagr = d["CAGR %"] / 100
    current_burden = if q1_income_monthly > 0, do: current_rent / q1_income_monthly, else: 0

    cross_year =
      if current_burden >= threshold do
        latest_year
      else
        if rent_cagr > income_growth_annual and current_rent > 0 do
          t = :math.log(threshold * q1_income_monthly / current_rent) /
              :math.log((1 + income_growth_annual) / (1 + rent_cagr))
          round(latest_year + t)
        else
          9999
        end
      end

    %{"Kanton" => d["Kanton"], "Belastung %" => Float.round(current_burden * 100, 1),
      "Schwelle erreicht" => cross_year, "CAGR %" => d["CAGR %"]}
  end)
  |> Enum.filter(fn d -> d["Schwelle erreicht"] < 2060 end)
  |> Enum.sort_by(fn d -> d["Schwelle erreicht"] end)

chart_prognose =
  Vl.new(width: 720, height: 500,
    title: "Wann erreicht Q1 die 30%-Schwelle? (bei 1% Einkommenswachstum)")
  |> Vl.data_from_values(projection_data)
  |> Vl.mark(:bar, corner_radius_end: 4)
  |> Vl.encode_field(:y, "Kanton", type: :nominal, title: nil,
    sort: [field: "Schwelle erreicht", order: "ascending"])
  |> Vl.encode_field(:x, "Schwelle erreicht", type: :quantitative,
    title: "Jahr der 30%-Überschreitung", scale: [domain: [2020, 2060]])
  |> Vl.encode_field(:color, "Schwelle erreicht", type: :quantitative,
    scale: [scheme: "redyellowgreen", reverse: true], legend: nil)
  |> Vl.config(font: "Switzer, system-ui, sans-serif", view: [stroke: "transparent"])
```

## Kernaussage

```elixir
already = projection_data |> Enum.filter(fn d -> d["Schwelle erreicht"] <= latest_year end) |> Enum.map(& &1["Kanton"])
soon = projection_data |> Enum.filter(fn d -> d["Schwelle erreicht"] > latest_year and d["Schwelle erreicht"] <= 2035 end)
  |> Enum.map(fn d -> "#{d["Kanton"]} (#{d["Schwelle erreicht"]})" end)

Kino.Markdown.new("""
### Kernaussage

Q1 zahlt national **40%** für Miete — weit über 30%.

- **Bereits kritisch**: #{Enum.join(already, ", ")}
- **Kritisch bis 2035**: #{Enum.join(soon, ", ")}

**Einschränkungen**: Q1-Einkommen pauschal (CHF 2'800/Mt). CAGR extrapoliert
linear. Keine Leerwohnungsquoten oder Regulierung berücksichtigt.
""")
```

