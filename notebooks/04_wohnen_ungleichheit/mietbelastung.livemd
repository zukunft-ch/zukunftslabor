Mix.install([
  {:explorer, "~> 0.11"},
  {:vega_lite, "~> 0.1"},
  {:kino_vega_lite, "~> 0.1"},
  {:kino_explorer, "~> 0.1"},
  {:kino, "~> 0.14"},
  {:jason, "~> 1.4"},
